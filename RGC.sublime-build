{
    "cmd": ["rgc", "$file", "-o", "$file_base_name"],
    "file_regex": "^(.*?):([0-9]+):([0-9]+): (?:error|warning): (.*)$",
    "selector": "source.rgc",
    "variants": [
        {
            "name": "Run",
            "cmd": ["rgc", "run", "$file"]
        },
        {
            "name": "Test",
            "cmd": ["rgc", "test", "$file"]
        }
    ]
}