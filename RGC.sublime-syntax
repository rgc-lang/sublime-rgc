%YAML 1.2
---
name: RGC
file_extensions:
  - rg
scope: source.rgc

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: keywords
    - include: types
    - include: builtins
    - include: constants
    - include: borrow
    - include: operators
    - include: punctuation

  comments:
    - match: '#'
      scope: punctuation.definition.comment.rgc
      push:
        - meta_scope: comment.line.number-sign.rgc
        - match: $
          pop: true
    - match: /\*
      scope: punctuation.definition.comment.begin.rgc
      push:
        - meta_scope: comment.block.rgc
        - match: \*/
          scope: punctuation.definition.comment.end.rgc
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.rgc
      push:
        - meta_scope: string.quoted.double.rgc
        - match: '\\.'
          scope: constant.character.escape.rgc
        - match: '"'
          scope: punctuation.definition.string.end.rgc
          pop: true

  numbers:
    - match: '\b(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric.rgc

  keywords:
    - match: '\b(if|elif|else|for|in|while|break|continue|pass|return|match|case|from|public)\b'
      scope: keyword.control.rgc
    - match: '\b(def|class|enum|interface|import)\b'
      scope: keyword.control.rgc
    - match: '\b(and|or|not)\b'
      scope: keyword.operator.rgc
    - match: '\bself\b'
      scope: variable.language.self.rgc

  types:
    - match: '\b(int|float|bool|str)\b'
      scope: support.type.rgc

  builtins:
    - match: '\b(print|range|to_string|args|read_file|write_file|system|len)\b'
      scope: support.function.builtin.rgc

  constants:
    - match: '\b(True|False|None)\b'
      scope: constant.language.rgc

  borrow:
    - match: '@var\b|@'
      scope: keyword.operator.borrow.rgc

  operators:
    - match: '=>|->|==|!=|<=|>=|<<|>>|\*\*|//|\+=|-=|\*=|/=|=|<|>|\+|-|\*|/|%|&|\||\^|!'
      scope: keyword.operator.rgc

  punctuation:
    - match: '[(){}\[\],:;.]'
      scope: punctuation.rgc